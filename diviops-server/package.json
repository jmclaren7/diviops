{
  "name": "@diviops/mcp-server",
  "version": "1.5.54",
  "description": "MCP server exposing Divi 5 Visual Builder as tools for Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "diviops-mcp": "dist/index.js",
    "diviops-preset": "dist/preset-cli/bin.js",
    "diviops-cross-env-preflight": "dist/cross-env-preflight/bin.js"
  },
  "files": [
    "dist/**/*",
    "!dist/**/__tests__/**",
    "!dist/launcher-bootstrap.js",
    "!dist/launcher-bootstrap.d.ts",
    "!dist/launcher-sidecar.js",
    "!dist/launcher-sidecar.d.ts",
    "!dist/authoring-browser-contract.js",
    "!dist/authoring-browser-contract.d.ts",
    "!dist/authoring-browser-coordinator.js",
    "!dist/authoring-browser-coordinator.d.ts",
    "!dist/authoring-browser-runtime.js",
    "!dist/authoring-browser-runtime.d.ts",
    "!dist/authoring-browser-worker.js",
    "!dist/authoring-browser-worker.d.ts",
    "templates",
    "data/verified-attrs.json",
    "data/verified-attrs-backlog.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "npx --yes esbuild@0.28.2 src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=bundle/diviops-mcp.mjs --legal-comments=eof --banner:js=\"import { createRequire as __diviopsCreateRequire } from 'module'; const require = __diviopsCreateRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/__tests__/*.test.js dist/preset-cli/__tests__/*.test.js dist/cross-env-preflight/__tests__/*.test.js scripts/authoring-release-boundary.test.mjs && node scripts/check-release-boundary.mjs",
    "prepublishOnly": "npm run build",
    "regen:skill": "node scripts/regen-module-formats.mjs",
    "check:authoring-shape-budget": "node scripts/check-page-sized-html-fallback-production-budget.mjs"
  },
  "keywords": [
    "mcp",
    "divi",
    "wordpress",
    "claude",
    "visual-builder",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmclaren7/diviops.git",
    "directory": "diviops-server"
  },
  "bugs": {
    "url": "https://github.com/jmclaren7/diviops/issues"
  },
  "homepage": "https://github.com/jmclaren7/diviops/tree/main/diviops-server#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "body-parser": "2.3.0",
    "fast-uri": "3.1.7",
    "hono": "4.13.5",
    "ip-address": "10.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.0.0",
    "playwright-core": "1.62.1",
    "typescript": "^5.7.0"
  }
}
